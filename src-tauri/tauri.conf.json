{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Countdown",
  "version": "0.9.0",
  "identifier": "com.whitebalance2800k.countdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Countdown",
        "width": 920,
        "height": 760,
        "minWidth": 390,
        "minHeight": 560,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first countdown tracker",
    "longDescription": "Countdown tracks renewals, deadlines, reminders, archived items, and recurring dates with local-first storage.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
