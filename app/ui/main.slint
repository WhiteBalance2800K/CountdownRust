import { Button, LineEdit, ComboBox, CheckBox, ListView } from "std-widgets.slint";

export struct UiItem {
    id: string,
    name: string,
    date: string,
    days-text: string,
    category: string,
    note: string,
    archived: bool,
    repeat: string,
    urgent: bool,
    warning: bool,
}

component StatPill inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <brush> tone;
    in property <brush> surface1;
    in property <brush> line;
    in property <brush> muted;
    border-radius: 9px;
    background: surface1;
    border-color: line;
    border-width: 1px;
    width: 66px;
    height: 48px;
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 1px;
        Text { text: value; color: tone; font-size: 17px; font-weight: 800; }
        Text { text: label; color: muted; font-size: 11px; }
    }
}

component Card inherits Rectangle {
    in property <UiItem> item;
    in property <int> index;
    in property <bool> selected;
    in property <brush> surface1;
    in property <brush> surface2;
    in property <brush> selectedSurface;
    in property <brush> line;
    in property <brush> textColor;
    in property <brush> muted;
    in property <brush> faint;
    in property <brush> accent;
    in property <brush> warningColor;
    in property <brush> danger;
    callback clicked(int);
    height: 96px;
    border-radius: 12px;
    border-width: 1px;
    border-color: selected ? accent : item.urgent ? danger : item.warning ? warningColor : line;
    background: selected ? selectedSurface : surface1;

    TouchArea { clicked => { root.clicked(index); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: item.archived ? "□" : "▣"; color: accent; font-size: 13px; }
                Text { text: item.name; color: textColor; font-size: 15px; font-weight: 800; overflow: elide; }
            }
            Text { text: item.date; color: muted; font-size: 12px; }
            HorizontalLayout {
                spacing: 6px;
                if item.category != "": Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: surface2;
                    Text { x: 8px; y: 2px; text: item.category; color: muted; font-size: 10px; }
                }
                if item.repeat != "": Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: surface2;
                    Text { x: 8px; y: 2px; text: item.repeat; color: muted; font-size: 10px; }
                }
            }
        }

        Rectangle { width: 1px; background: transparent; }
        VerticalLayout {
            alignment: center;
            Text { horizontal-alignment: right; text: item.days-text; color: item.urgent ? danger : item.warning ? warningColor : textColor; font-size: 30px; font-weight: 800; }
            Text { horizontal-alignment: right; text: item.urgent ? "临近" : item.warning ? "30天内" : "剩余"; color: faint; font-size: 11px; }
        }
    }
}

export component MainWindow inherits Window {
    title: "Countdown";
    width: 920px;
    height: 760px;

    in property <[UiItem]> items;
    in property <int> selected-index: -1;
    in property <string> title-text: "Countdown";
    in property <string> total-count: "0";
    in property <string> soon-count: "0";
    in property <string> overdue-count: "0";
    in property <string> toast: "";
    in-out property <int> theme-mode: 0;
    in property <bool> system-dark-mode: false;
    property <bool> dark-mode: theme-mode == 2 || (theme-mode == 0 && system-dark-mode);
    in-out property <int> filter-index: 0;
    in-out property <string> name-input;
    in-out property <string> days-input: "30";
    in-out property <string> category-input;
    in-out property <string> note-input;
    in-out property <string> reminders-input: "7, 0";
    in-out property <bool> archived-input: false;
    in-out property <string> bark-input;
    in-out property <bool> push-enabled: false;
    in-out property <bool> launch-at-login: false;
    in property <string> data-dir: "";

    callback select-item(int);
    callback add-item();
    callback save-item();
    callback delete-item();
    callback archive-toggle();
    callback renew-item();
    callback move-up();
    callback move-down();
    callback sort-near();
    callback filter-changed(int);
    callback open-data-dir();
    callback save-settings();
    callback test-push();
    callback theme-changed(int);

    property <brush> canvas: dark-mode ? #090908 : #f4f2ed;
    property <brush> surface1: dark-mode ? #151513 : #fffdfa;
    property <brush> surface2: dark-mode ? #22221f : #ebe7de;
    property <brush> selectedSurface: dark-mode ? #241b12 : #fff2e4;
    property <brush> line: dark-mode ? #33332f : #d7d0c0;
    property <brush> text: dark-mode ? #eee9df : #242520;
    property <brush> muted: dark-mode ? #aaa39a : #696458;
    property <brush> faint: dark-mode ? #777069 : #938c80;
    property <brush> accent: #d66a13;
    property <brush> warning: dark-mode ? #ffd166 : #a77408;
    property <brush> danger: dark-mode ? #ff6656 : #c94337;

    background: canvas;

    HorizontalLayout {
        padding: 18px;
        spacing: 16px;

        VerticalLayout {
            spacing: 12px;
            width: 560px;

            HorizontalLayout {
                height: 36px;
                ComboBox {
                    width: 132px;
                    model: ["进行中", "全部", "30天内", "已过期", "归档"];
                    current-index: root.filter-index;
                    selected(value) => { root.filter-changed(self.current-index); }
                }
                Rectangle { background: transparent; }
                ComboBox {
                    width: 116px;
                    model: ["自动", "白天", "夜间"];
                    current-index: root.theme-mode;
                    selected(value) => { root.theme-changed(self.current-index); }
                }
            }

            HorizontalLayout {
                height: 64px;
                VerticalLayout {
                    Text { text: "COUNTDOWN"; color: root.accent; font-size: 12px; font-weight: 800; }
                    Text { text: root.title-text; color: root.text; font-size: 32px; font-weight: 800; overflow: elide; }
                }
                StatPill { value: root.total-count; label: "全部"; tone: root.text; surface1: root.surface1; line: root.line; muted: root.muted; }
                StatPill { value: root.soon-count; label: "30天内"; tone: root.warning; surface1: root.surface1; line: root.line; muted: root.muted; }
                StatPill { value: root.overdue-count; label: "已过期"; tone: root.danger; surface1: root.surface1; line: root.line; muted: root.muted; }
            }

            ListView {
                height: 516px;
                for item[index] in root.items: Card {
                    item: item;
                    index: index;
                    selected: index == root.selected-index;
                    surface1: root.surface1;
                    surface2: root.surface2;
                    selectedSurface: root.selectedSurface;
                    line: root.line;
                    textColor: root.text;
                    muted: root.muted;
                    faint: root.faint;
                    accent: root.accent;
                    warningColor: root.warning;
                    danger: root.danger;
                    clicked(index) => { root.select-item(index); }
                }
            }

            HorizontalLayout {
                height: 44px;
                spacing: 8px;
                Button { text: "新增"; clicked => { root.add-item(); } }
                Button { text: "保存"; clicked => { root.save-item(); } }
                Button { text: "删除"; enabled: root.selected-index >= 0; clicked => { root.delete-item(); } }
                Button { text: "归档/恢复"; enabled: root.selected-index >= 0; clicked => { root.archive-toggle(); } }
                Button { text: "续期"; enabled: root.selected-index >= 0; clicked => { root.renew-item(); } }
                Button { text: "上移"; enabled: root.selected-index > 0; clicked => { root.move-up(); } }
                Button { text: "下移"; enabled: root.selected-index >= 0; clicked => { root.move-down(); } }
                Button { text: "临近排序"; clicked => { root.sort-near(); } }
            }
        }

        Rectangle {
            width: 296px;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.line;
            background: root.surface1;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: "编辑"; color: root.text; font-size: 20px; font-weight: 800; }
                Text { text: "名称"; color: root.muted; font-size: 12px; }
                LineEdit { text <=> root.name-input; placeholder-text: "例如：会员续费、证件到期"; }
                Text { text: "剩余天数"; color: root.muted; font-size: 12px; }
                LineEdit { text <=> root.days-input; input-type: number; }
                Text { text: "分类"; color: root.muted; font-size: 12px; }
                LineEdit { text <=> root.category-input; placeholder-text: "订阅、证件、域名"; }
                Text { text: "提醒天数"; color: root.muted; font-size: 12px; }
                LineEdit { text <=> root.reminders-input; placeholder-text: "30, 7, 1, 0"; }
                Text { text: "备注"; color: root.muted; font-size: 12px; }
                LineEdit { text <=> root.note-input; placeholder-text: "备注"; }
                CheckBox { text: "归档"; checked <=> root.archived-input; }

                Rectangle { height: 1px; background: root.line; }
                Text { text: "设置"; color: root.text; font-size: 18px; font-weight: 800; }
                CheckBox { text: "启用 Bark 推送"; checked <=> root.push-enabled; }
                LineEdit { text <=> root.bark-input; placeholder-text: "https://api.day.app/你的Key"; }
                CheckBox { text: "开机启动"; checked <=> root.launch-at-login; }
                HorizontalLayout {
                    Button { text: "保存设置"; clicked => { root.save-settings(); } }
                    Button { text: "测试推送"; clicked => { root.test-push(); } }
                }
                Button { text: "打开数据目录"; clicked => { root.open-data-dir(); } }
                Text { text: root.data-dir; color: root.faint; font-size: 10px; wrap: word-wrap; }
                Text { text: root.toast; color: root.accent; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}
